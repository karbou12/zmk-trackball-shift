config ZMK_TRACKBALL_SHIFT
    bool
    default y
    depends on ZMK_POINTING
    depends on (!ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL)
    help
        Enable Trackball Shift for ZMK.

if ZMK_TRACKBALL_SHIFT

config ZMK_TRACKBALL_SHIFT_DIRECTION_ANGLE_DEG
    int "Angle [deg] of each direction for trackball shift."
    default 45
    range 3 45
    help
        This value must be a divisor of 360.

config ZMK_TRACKBALL_SHIFT_ROTATION_SAMPLE_TIME_MS
    int "Sample time [ms] for rotation behavior."
    default 3000
    help
        Used for handling multiple inputs from a rotary encoder.
        If the encoder's step angle is smaller than direction_angle_deg,
        steps are accumulated within the sample time.
        Once the accumulated angle exceeds direction_angle_deg, the system triggers a rotation of direction_angle_deg.
        If the threshold is not exceeded within this time, the accumulated steps are reset.

config ZMK_TRACKBALL_SHIFT_DISTANCE_THRESHOLD
    int "Threshold of distance for direction detection of trackball shift"
    default 800

config ZMK_TRACKBALL_SHIFT_DETECTION_SAMPLE_TIME_MS
    int "Sample time [ms] for direction detection of trackball shift"
    default 100

module = TRACKBALL_SHIFT
module-str = TRACKBALL_SHIFT
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # ZMK_TRACKBALL_SHIFT
