#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/trackball_shift_rotation.h>

/ {
    behaviors {
#if ZMK_BEHAVIOR_OMIT(TB_ROT_45)
        /omit-if-no-ref/
#endif
        tb_rot_45: tr45 {
            compatible = "zmk,behavior-trackball-shift-rotation";
            #binding-cells = <1>;
            step-angle-deg = <45>;
            display-name = "Trackball Shift Rotation with 45 [deg]";
        };

#if ZMK_BEHAVIOR_OMIT(ENC_TB_ROT_45)
        /omit-if-no-ref/
#endif
        enc_tb_rot_45: enc_tr45 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&tb_rot_45 TB_ROT_CCW>, <&tb_rot_45 TB_ROT_CW>;
        };
    };
};
